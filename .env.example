# =============================================================
# Smart College Attendance Management System — Environment Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# ---- PostgreSQL ----
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=attendance_db
POSTGRES_USER=attendance_user
POSTGRES_PASSWORD=change_me_strong_password

# ---- Backend ----
DATABASE_URL=postgresql+asyncpg://attendance_user:change_me_strong_password@db:5432/attendance_db
SECRET_KEY=change_me_to_a_very_long_random_secret_key_at_least_64_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- File Upload ----
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ---- Document Extraction & OCR ----
# Extraction provider strategy: auto | gemini | pymupdf | tesseract
ATTENDANCE_EXTRACTION_PROVIDER=auto
ENABLE_OPENCV_GRID_DETECTION=true

# Google Gemini API (Primary provider for handwritten registers)
# Leave blank to use PyMuPDF (digital PDFs) & OpenCV+Tesseract (scanned fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Tesseract executable path (auto-detected on Windows if installed in Program Files)
TESSERACT_CMD=tesseract
OCR_MIN_CONFIDENCE=50

# ---- Attendance Settings ----
MIN_ATTENDANCE_PERCENTAGE=75

# ---- Admin Bootstrap ----
# Used only by the first-run admin creation script
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@college.edu
BOOTSTRAP_ADMIN_PASSWORD=change_me_admin_password

# ---- Environment ----
# development | production
APP_ENV=development

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000
